# Proveedor: groq | openai | anthropic
LLM_PROVIDER=groq

# Groq — gratis, sin tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (opcional, pago): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (opcional, pago): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Opcionales
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=30
# Reintentos del SDK ante errores HTTP transitorios (429, 5xx)
LLM_MAX_RETRIES=2
# Intentos de la cadena ante JSON mal formado o incompleto (.with_retry)
PIPELINE_MAX_ATTEMPTS=3
